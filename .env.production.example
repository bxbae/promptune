# PrompTune 배포용 환경변수 (EC2에서 사용)
# 이 파일을 .env.production 으로 복사하고 실제 값을 채우세요.
# .env.production 은 git에 안 올라갑니다 (.gitignore 처리됨)

# ── RDS (이미 배포한 AWS RDS) ──
SPRING_DATASOURCE_URL=jdbc:postgresql://promptune-db.cxwue8u66qin.ap-northeast-2.rds.amazonaws.com:5432/promptune
SPRING_DATASOURCE_USERNAME=promptune
SPRING_DATASOURCE_PASSWORD=<RDS_비밀번호>

# ── 배포 도메인 (EC2 public IP 또는 도메인) ──
# 예: EC2 IP가 12.34.56.78 이면 http://12.34.56.78:3000 형태
APP_FRONTEND_URL=http://<배포주소>:3000
APP_CORS_ORIGINS=http://<배포주소>:3000
NEXT_PUBLIC_API_URL=http://<배포주소>:8080

# ── JWT (운영용으로 반드시 변경) ──
JWT_SECRET=<32자-이상-랜덤-문자열>

# ── 소셜 로그인 키 (있으면) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── AI 모델 스위치 (배포 초기엔 false=mock 권장, 메모리 절약) ──
USE_REAL_MODELS=false
USE_REAL_DIAGNOSIS=false
USE_REAL_SPELLCHECK=false
USE_REAL_SUGGESTION=false

# ── Microsoft 연동 (있으면) ──
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_FRONTEND_URL=
MICROSOFT_TOKEN_KEY=
