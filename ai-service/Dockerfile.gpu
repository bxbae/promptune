FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .

# GPU 테스트용 빌드. CPU 전용(Dockerfile)과 달리 CUDA 지원 torch를 설치한다.
#
# 아래 cu121은 예시값이다 — 실제로는 이 이미지를 빌드하는 EC2 인스턴스에서
# `nvidia-smi`로 확인한 "CUDA Version"에 맞는 인덱스를 골라야 한다
# (예: CUDA 12.1 -> cu121, CUDA 12.4 -> cu124). 맞지 않으면 torch가 설치는
# 되지만 torch.cuda.is_available()이 False로 나온다.
# 전체 목록: https://pytorch.org/get-started/locally/
RUN pip install --no-cache-dir \
    torch==2.12.1 \
    --index-url https://download.pytorch.org/whl/cu121

RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
